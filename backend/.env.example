# ============================================
# APP
# ============================================
NODE_ENV=development
PORT=4000

# Origin frontend yang diizinkan (pisah dengan koma)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================
# DATABASE (PostgreSQL)
# ============================================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://presensi:presensi_dev_password@localhost:5432/presensi_dev?schema=public

# ============================================
# SESSION (Cookie)
# ============================================
SESSION_COOKIE_NAME=presensi_session
# 8 jam = 28800000 ms
SESSION_MAX_AGE_MS=28800000
SESSION_SAME_SITE=lax

# ============================================
# SECURITY
# ============================================
BCRYPT_ROUNDS=12

# ============================================
# UPLOAD (Surat sakit)
# ============================================
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_BYTES=5242880

# ============================================
# ADMIN PERTAMA (Opsional; hanya dipakai sekali saat menjalankan seed)
# ============================================
# INITIAL_ADMIN_EMAIL=admin@sekolah.sch.id
# INITIAL_ADMIN_PASSWORD=
