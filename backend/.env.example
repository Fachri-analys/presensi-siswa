# ============================================
# APP
# ============================================
NODE_ENV=development
PORT=4000

# Origin frontend yang diizinkan (pisah dengan koma)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================
# DATABASE (SQLite)
# ============================================
# Path relatif terhadap schema Prisma; file lokal diabaikan oleh Git.
DATABASE_URL=file:./dev.db

# ============================================
# SESSION (Cookie)
# ============================================
SESSION_COOKIE_NAME=presensi_session
# 8 jam = 28800000 ms
SESSION_MAX_AGE_MS=28800000
SESSION_SAME_SITE=lax

# Kalender sekolah: hari ISO (Senin=1 ... Minggu=7), serta tanggal libur CSV.
SCHOOL_WORKING_DAYS=1,2,3,4,5
SCHOOL_HOLIDAYS=

# ============================================
# SECURITY
# ============================================
BCRYPT_ROUNDS=12

# ============================================
# UPLOAD (Surat sakit)
# ============================================
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_BYTES=5242880

# Opsional untuk profile Docker pgAdmin; ganti dengan password lokal yang kuat.
PGADMIN_DEFAULT_EMAIL=admin@presensi.local
PGADMIN_DEFAULT_PASSWORD=change-this-local-password

# ============================================
# ADMIN PERTAMA (Opsional; hanya dipakai sekali saat menjalankan seed)
# ============================================
# INITIAL_ADMIN_EMAIL=admin@sekolah.sch.id
# INITIAL_ADMIN_PASSWORD=
