# Copy to .env.production on the server. Replace every example value.
DOMAIN=presensi.example.sch.id
PUBLIC_API_BASE_URL=https://presensi.example.sch.id/api/v1/
VOLUME_PREFIX=presensi

POSTGRES_USER=presensi
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_SECRET
POSTGRES_DB=presensi
POSTGRES_APP_USER=presensi_app
POSTGRES_APP_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_SECRET

NODE_ENV=production
PORT=4000
SESSION_COOKIE_NAME=presensi_session
SESSION_MAX_AGE_MS=28800000
SESSION_SAME_SITE=lax
BCRYPT_ROUNDS=12
SCHOOL_WORKING_DAYS=1,2,3,4,5
SCHOOL_HOLIDAYS=
UPLOAD_DIR=/app/uploads
UPLOAD_MAX_SIZE_BYTES=5242880

# One-time bootstrap. Remove both values from the server file after seeding.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Optional host-side ports for staging or local checks.
API_HOST_PORT=4000
WEB_HOST_PORT=3000
